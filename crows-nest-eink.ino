// Button task, pinned to core 0 (the WiFi core; the loop runs on core 1).
// It does nothing but read pins, so it never stalls behind a panel refresh
// or an HTTP request.
static void buttonTask(void*)
{
  bool stable[NUM_BTNS], last[NUM_BTNS];
  uint32_t changedAt[NUM_BTNS];
  for (int i = 0; i < NUM_BTNS; i++)
  {
    stable[i] = last[i] = digitalRead(BTN_PINS[i]);
    changedAt[i] = millis();
    btnRawDown[i] = (stable[i] == LOW);
  }
  for (;;)
  {
    uint32_t now = millis();
    for (int i = 0; i < NUM_BTNS; i++)
    {
      bool r = digitalRead(BTN_PINS[i]);
      if (r != last[i]) { last[i] = r; changedAt[i] = now; }
      if (now - changedAt[i] >= DEBOUNCE_MS && r != stable[i])
      {
        stable[i] = r;
        btnRawDown[i] = (r == LOW);
        BtnEvent e = { (uint8_t)i, r == LOW, now };
        xQueueSend(btnQueue, &e, 0);   // queue holds 32; a full queue drops the event
      }
    }
    vTaskDelay(pdMS_TO_TICKS(5));
  }
}

static void logRefreshCounts()
{
  dlog("Refreshes: session %lu full + %lu partial, lifetime %lu full + %lu partial",
       (unsigned long)sessionFull, (unsigned long)sessionPartial,
       (unsigned long)lifetimeFull, (unsigned long)lifetimePartial);
}

// Count a panel refresh (the prime partial after a full is part of the full).
// Lifetime totals go to NVS, which wear-levels; at most a few hundred writes a day.
static void countRefresh(bool full)
{
  if (full) { sessionFull++; lifetimeFull++; }
  else      { sessionPartial++; lifetimePartial++; }
  if (statsNvs)
  {
    if (full) nvs_set_u32(statsNvs, "full", lifetimeFull);
    else      nvs_set_u32(statsNvs, "partial", lifetimePartial);
    nvs_commit(statsNvs);
  }
  logRefreshCounts();
}

// refreshing / full describe what the panel is doing right now
static void updatePowerLed(bool refreshing, bool full)
{
  bool on = POWER_LED_MODE == LED_ALWAYS_ON ||
            (POWER_LED_MODE == LED_ANY_REFRESH && refreshing) ||
            (POWER_LED_MODE == LED_FULL_REFRESH && refreshing && full);
  digitalWrite(PIN_PWR_LED, on ? HIGH : LOW);
}

static uint32_t fullRefresh(const char* why)
{
  uint32_t t0 = millis();
  updatePowerLed(true, true);
  EPD_RESET();
  delay(20);
  EPD_Init_Fast(Fast_Seconds_1_5s);
  EPD_Display_Fast(Image_BW);
  // Prime: push the identical frame as a partial so both controller
  // memories match. No visible change. Without this the next partial ghosts.
  EPD_Display_Part(0, 0, EPD_W, EPD_H, Image_BW);
  updatePowerLed(false, false);
  partialsSinceFull = 0;
  uint32_t dt = millis() - t0;
  dlog("FULL refresh (%s): %lu ms", why, dt);
  countRefresh(true);
  return dt;
}

static uint32_t partialRefresh()
{
  uint32_t t0 = millis();
  updatePowerLed(true, false);
  EPD_Display_Part(0, 0, EPD_W, EPD_H, Image_BW);
  updatePowerLed(false, false);
  partialsSinceFull++;
  uint32_t dt = millis() - t0;
  dlog("PARTIAL refresh: %lu ms (partials since full: %d)", dt, partialsSinceFull);
  countRefresh(false);
  return dt;
}


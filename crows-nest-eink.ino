// =====================================================
// Home Assistant template (built from config.h)
// =====================================================
String haTemplate;   // built once from the config at boot

static void tplNum(String& t, const char* eid)
{
  if (!eid || !*eid) { t += "none"; return; }
  t += "states('"; t += eid; t += "') | float(none)";
}

static void tplStr(String& t, const char* eid)
{
  if (!eid || !*eid) { t += "none"; return; }
  t += "states('"; t += eid; t += "')";
}

// Sunrise/sunset: a configured entity, or sun.sun's next rising/setting
static void tplSun(String& t, const char* eid, const char* attr)
{
  if (eid && *eid) { tplStr(t, eid); return; }
  t += "(state_attr('sun.sun', '"; t += attr;
  t += "') | as_timestamp(none) | timestamp_custom('%H:%M', true, none))";
}

// One POST /api/template per poll returns everything as compact JSON:
//   n: numbers (NumField order), t: [condition, best share, sunrise, sunset],
//   m: miners [GH/s, W, ASIC temp, best], rooms: [lit, total, brightness %, [lit entity_ids]] per tile
static void buildTemplate()
{
  String t;
  t.reserve(4096);
  String areas = "[";
  for (int i = 0; i < NUM_ROOMS; i++)
  {
    if (i) areas += ", ";
    if (ROOMS[i].area) { areas += "'"; areas += ROOMS[i].area; areas += "'"; }
    else areas += "none";
  }
  areas += "]";
  String rooms = ROOMS_TEMPLATE;
  rooms.replace("AREAS", areas);
  t += rooms;

  t += "{{ {\n\"n\": [";
  for (int k = 0; k < NUM_NUM; k++)
  {
    if (k) t += ",\n  ";
    tplNum(t, (NUM_IS_MINING[k] && !SHOW_MINING) ? "" : NUM_ENTITY[k]);
  }
  t += "],\n\"t\": [";
  tplStr(t, HA_WEATHER);              t += ", ";
  tplStr(t, SHOW_MINING ? HA_MINING_BEST_SHARE : ""); t += ", ";
  tplSun(t, HA_SUNRISE, "next_rising"); t += ", ";
  tplSun(t, HA_SUNSET, "next_setting");
  t += "],\n\"m\": [";
  for (int i = 0; SHOW_MINING && i < NUM_MINERS; i++)
  {
    const MinerConfig& m = MINER_CFG[i];
    if (i) t += ",\n  ";
    t += "[";
    tplNum(t, m.hashrate); t += ", ";
    tplNum(t, m.power);    t += ", ";
    tplNum(t, m.asicTemp); t += ", ";
    tplStr(t, m.best);
    t += "]";
  }
  t += "],\n\"rooms\": nl.r,\n\"ts\": now().strftime('%H:%M'),\n\"hr\": now().hour\n} | to_json }}";
  haTemplate = t;
}

// =====================================================
// Logging
// =====================================================
static void dlog(const char* fmt, ...)
{
  char msg[256];
  va_list args;
  va_start(args, fmt);
  vsnprintf(msg, sizeof(msg), fmt, args);
  va_end(args);
  Serial.printf("[%8lu ms] %s\n", millis(), msg);
}

// =====================================================
// Small helpers
// =====================================================
static inline bool timeReached(uint32_t now, uint32_t t) { return (int32_t)(now - t) >= 0; }

static void copyClean(char* dst, size_t n, const char* src)
{
  size_t j = 0;
  if (src)
  {
    for (size_t i = 0; src[i] && j + 1 < n; i++)
    {
      char c = src[i];
      if (c == '`') c = '\'';
      if (c >= 32 && c <= 126) dst[j++] = c;   // drops UTF-8 like the degree sign
    }
  }
  dst[j] = 0;
}

static void fmtNum(char* b, size_t n, float v, int dec, const char* suffix)
{
  if (isnan(v)) { snprintf(b, n, "--"); return; }
  snprintf(b, n, "%.*f%s", dec, v, suffix ? suffix : "");
}

static void fmtTemp(char* b, size_t n, float v, bool withC)
{
  if (isnan(v)) { snprintf(b, n, "--`"); return; }
  snprintf(b, n, withC ? "%.1f`" TEMP_UNIT : "%.1f`", v);
}

// Three significant figures with an SI prefix that moves up or down as the
// number grows: 126 P, 999 P, 1.00 E, 12.6 E ... `v` is in units of prefix
// index p (0 = none, 1 = K, 2 = M, 3 = G, 4 = T, 5 = P, 6 = E, 7 = Z, 8 = Y).
static const char* const SI_PREFIX = "\0KMGTPEZY";
static void fmtSI3(char* out, size_t n, float v, int p, const char* unit)
{
  if (isnan(v)) { snprintf(out, n, "--"); return; }
  while (v >= 999.5f && p < 8) { v /= 1000; p++; }
  while (v > 0 && v < 0.9995f && p > 0) { v *= 1000; p--; }
  int dec = (v >= 99.95f) ? 0 : (v >= 9.995f) ? 1 : 2;
  char pfx[2] = { p ? SI_PREFIX[p] : 0, 0 };
  snprintf(out, n, "%.*f %s%s", dec, v, pfx, unit);
}

// Three significant figures, no prefix: 8.15, 12.3, 123
static void fmtSig3(char* out, size_t n, float v)
{
  if (isnan(v)) { snprintf(out, n, "--"); return; }
  int dec = (v >= 99.95f) ? 0 : (v >= 9.995f) ? 1 : 2;
  snprintf(out, n, "%.*f", dec, v);
}

// Whole number with thousands separators and an optional prefix: "$58,668", "2,252"
static void fmtGrouped(char* out, size_t n, float v, const char* prefix)
{
  if (isnan(v)) { snprintf(out, n, "--"); return; }
  long long iv = llroundf(v);
  bool neg = iv < 0;
  if (neg) iv = -iv;
  char digits[24], grouped[32];
  snprintf(digits, sizeof(digits), "%lld", iv);
  int len = strlen(digits), j = 0;
  for (int i = 0; i < len; i++)
  {
    if (i > 0 && (len - i) % 3 == 0) grouped[j++] = ',';
    grouped[j++] = digits[i];
  }
  grouped[j] = 0;
  snprintf(out, n, "%s%s%s", neg ? "-" : "", prefix, grouped);
}

// USD amounts that are often cents: $0.224, $2.24, $22.40, $1,234
static void fmtUsd(char* out, size_t n, float v)
{
  if (isnan(v)) { snprintf(out, n, "--"); return; }
  if (fabsf(v) >= 1000) { fmtGrouped(out, n, v, "$"); return; }
  snprintf(out, n, fabsf(v) < 1 ? "$%.3f" : "$%.2f", v);
}

// Four significant figures with an SI prefix and no space: 134.8T, 1.348P.
// `v` is in units of prefix index p (see SI_PREFIX).
static void fmtSig4(char* out, size_t n, float v, int p)
{
  if (isnan(v)) { snprintf(out, n, "--"); return; }
  while (v >= 9999.5f && p < 8) { v /= 1000; p++; }
  int dec = (v >= 999.95f) ? 0 : (v >= 99.995f) ? 1 : (v >= 9.9995f) ? 2 : 3;
  char pfx[2] = { p ? SI_PREFIX[p] : 0, 0 };
  snprintf(out, n, "%.*f%s", dec, v, pfx);
}

// Best share from HA, e.g. "118.14 G" or a raw number -> "118 G", "1.10 T"
static void fmtBestShort(char* out, size_t n, const char* src)
{
  float v;
  char suf[8] = "";
  int got = sscanf(src, "%f %7s", &v, suf);
  if (got < 1) { snprintf(out, n, "%s", src); return; }
  int p = 0;
  if (got == 2)
  {
    const char* hit = strchr(SI_PREFIX + 1, toupper((unsigned char)suf[0]));
    if (!hit || !suf[0]) { snprintf(out, n, "%s", src); return; }
    p = hit - SI_PREFIX;
  }
  fmtSI3(out, n, v, p, "");
}

static const char* compass16(float deg)
{
  static const char* d[16] = { "N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE",
                               "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW" };
  if (isnan(deg)) return "--";
  int i = (int)((fmodf(deg, 360.0f) + 360.0f + 11.25f) / 22.5f) % 16;
  return d[i];
}

static const char* condName(const char* c)
{
  struct { const char* k; const char* v; } map[] = {
    { "clear-night", "Clear night" }, { "cloudy", "Cloudy" },
    { "exceptional", "Exceptional" }, { "fog", "Fog" }, { "hail", "Hail" },
    { "lightning", "Lightning" }, { "lightning-rainy", "Thunderstorm" },
    { "partlycloudy", "Partly cloudy" }, { "pouring", "Pouring" },
    { "rainy", "Rainy" }, { "snowy", "Snowy" }, { "snowy-rainy", "Sleet" },
    { "sunny", "Sunny" }, { "windy", "Windy" }, { "windy-variant", "Windy" },
  };
  for (auto& e : map) if (!strcmp(c, e.k)) return e.v;
  return c[0] ? c : "--";
}

static bool parseCount(const char* s, int* a, int* b)
{
  return s && sscanf(s, "%d of %d", a, b) == 2;
}

// "2 of 4 on" -> "2 of 4"
static void countLabel(char* out, size_t n, const Room& r)
{
  int a, b;
  if (!r.valid) { snprintf(out, n, "--"); return; }
  if (parseCount(r.count, &a, &b)) { snprintf(out, n, "%d of %d", a, b); return; }
  snprintf(out, n, "%s", r.on ? "ON" : "off");
}

static Room shownRoom(int i)
{
  Room r = data.rooms[i];
  if (overrides[i].active)
  {
    r.valid = true;
    r.on = overrides[i].on;
    snprintf(r.count, sizeof(r.count), "%s", overrides[i].count);
    if (overrides[i].hasBri) r.bri = overrides[i].bri;
    else if (!r.on) r.bri = NAN;
  }
  return r;
}

static bool inQuietHours()
{
  if (QUIET_START_HOUR == QUIET_END_HOUR || data.hour < 0) return false;
  if (QUIET_START_HOUR < QUIET_END_HOUR)
    return data.hour >= QUIET_START_HOUR && data.hour < QUIET_END_HOUR;
  return data.hour >= QUIET_START_HOUR || data.hour < QUIET_END_HOUR;
}


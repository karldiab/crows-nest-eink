// How many brightness levels a reading reaches (0 = off, at least 1 when on)
static int briSegments(float bri)
{
  if (isnan(bri) || bri <= 0) return 0;
  int n = 0;
  for (int k = 0; k < NUM_BRI_LEVELS; k++) if (BRI_LEVELS[k] <= bri + BRI_TOL) n = k + 1;
  return max(n, 1);
}

// Brightness bar: one segment per level, filled from the bottom
static void drawBriBar(int x, int y, float bri)
{
  const int H = 38, GAP = 2;
  const int segH = max(2, (H - (NUM_BRI_LEVELS - 1) * GAP) / NUM_BRI_LEVELS);
  int segs = briSegments(bri);
  for (int k = 0; k < NUM_BRI_LEVELS; k++)
  {
    int sy = y + H - (k + 1) * segH - k * GAP;
    if (k < segs) gFillRect(x, sy, 7, segH, BLACK);
    else          gRect(x, sy, 7, segH, 1, BLACK);
  }
}

// Off / low / medium / high from the room's average brightness. Lights that
// don't report brightness (on/off only) show as high.
static int bulbLevel(const Room& r)
{
  if (!(r.valid && r.on)) return BULB_OFF;
  if (isnan(r.bri)) return BULB_HIGH;
  if (r.bri < 34) return BULB_LOW;
  if (r.bri < 67) return BULB_MEDIUM;
  return BULB_HIGH;
}

static void drawRoomTile(int i)
{
  // Tiles share the width evenly (1 to 5 rooms)
  const int w = EPD_W / NUM_ROOMS;
  const int tx = i * w, ty = 160, cx = tx + w / 2;
  Room r = shownRoom(i);
  bool sel = lightsFocused() && cursorRoom == i;

  if (sel) gRoundRect(tx + 4, ty + 1, w - 8, 102, 10, 3, BLACK);
  if (i > 0) dottedVLine(tx, ty + 14, ty + 88);

  gfxTextC(FONT_LABEL, cx, ty + 20, ROOMS[i].name, BLACK);
  drawBulb(cx - 26, ty + 24, 44, bulbLevel(r));
  if (r.valid && r.on && !isnan(r.bri)) drawBriBar(cx + 26, ty + 28, r.bri);
  char c[20];
  countLabel(c, sizeof(c), r);
  gfxTextC(FONT_LABEL, cx, ty + 92, c, BLACK);
}

// Bottom line of the Home page: segments spread evenly, bold if they fit
static void drawSegmentLine(char seg[][24], int n)
{
  const int avail = EPD_W - 12;
  const GFXfont* f = FONT_LABEL;
  int total = 0;
  for (int i = 0; i < n; i++) total += gfxTextW(f, seg[i]);
  if (avail - total < (n - 1) * 8)
  {
    f = FONT_SMALL;
    total = 0;
    for (int i = 0; i < n; i++) total += gfxTextW(f, seg[i]);
  }
  int gap = n > 1 ? max(4, (avail - total) / (n - 1)) : 0;
  int x = n > 1 ? 6 : (EPD_W - total) / 2;
  for (int i = 0; i < n; i++)
  {
    gfxText(f, x, 287, seg[i], BLACK);
    x += gfxTextW(f, seg[i]);
    if (i < n - 1)
    {
      gFillCircle(x + gap / 2, 282, 1, BLACK);   // separator dot
      x += gap;
    }
  }
}

#if SHOW_MINING
// Home bottom line with mining on: three items with bigger numbers and
// smaller units, e.g. "$58,668 . 8.12 TH/s . 2.25 KYRS/BLOCK". The outer
// items sit PAD pixels in from the edges and the leftover space is split
// into the two gaps. If very long numbers don't fit, they drop to the unit
// size.
static void drawMiningLine(const char* const val[3], const char* const unit[3])
{
  const int PAD = 14, MIN_GAP = 14, SPACE = 5, BASE = 290;
  const GFXfont* vf = FONT_TITLE;
  const GFXfont* uf = FONT_LABEL;
  int w[3], total = 0;
  for (int pass = 0; pass < 2; pass++)
  {
    total = 0;
    for (int i = 0; i < 3; i++)
    {
      w[i] = gfxTextW(vf, val[i]) + (unit[i][0] ? SPACE + gfxTextW(uf, unit[i]) : 0);
      total += w[i];
    }
    if (EPD_W - 2 * PAD - total >= 2 * MIN_GAP) break;
    vf = FONT_LABEL;
  }
  int pad = PAD;
  if (EPD_W - 2 * pad - total < 2 * MIN_GAP) pad = max(2, (EPD_W - total - 2 * MIN_GAP) / 2);
  int gap = max(6, (EPD_W - 2 * pad - total) / 2);

  int x = pad;
  for (int i = 0; i < 3; i++)
  {
    gfxText(vf, x, BASE, val[i], BLACK);
    if (unit[i][0]) gfxText(uf, x + gfxTextW(vf, val[i]) + SPACE, BASE, unit[i], BLACK);
    x += w[i];
    if (i < 2)
    {
      gFillCircle(x + gap / 2, BASE - 6, 2, BLACK);   // separator dot
      x += gap;
    }
  }
}
#endif


// Per-room part of the template: lights in the area (or all lights) that
// aren't unavailable, which of them are on, and their average brightness.
static const char ROOMS_TEMPLATE[] = R"JINJA(
{%- set nl = namespace(r=[]) -%}
{%- for a in AREAS -%}
{%- set ls = (area_entities(a) if a else states.light | map(attribute='entity_id') | list)
      | select('match', 'light[.]') | reject('is_state', ['unavailable', 'unknown']) | list -%}
{%- set lit = ls | select('is_state', 'on') | list -%}
{%- set bs = lit | map('state_attr', 'brightness') | reject('none') | list -%}
{%- set nl.r = nl.r + [[lit | count, ls | count,
      ((bs | sum) / (bs | count) / 2.55) | round(0) if bs | count > 0 else none, lit]] -%}
{%- endfor -%}
)JINJA";


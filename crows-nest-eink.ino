  const int c1 = 178, c2 = 282;
  fmtGrouped(b, sizeof(b), data.btc, "$");   gText(c1, 38, b, 24, BLACK);
  gText(c2, 46, "DIFF", 12, BLACK);
  fmtSig4(b, sizeof(b), data.diff, 4);       gText(c2 + 28, 38, b, 24, BLACK);   // HA reports T
  fmtNum(b, sizeof(b), data.watts, 1, " W"); gText(c1, 66, b, 24, BLACK);
  fmtNum(b, sizeof(b), data.jth, 1, " J/TH"); gText(c2, 66, b, 24, BLACK);

  gHLine(8, EPD_W - 9, 94, BLACK);

  // --- Per-miner table ---
  gText(10, 96, "MINER", 12, BLACK);
  gText(100, 96, "GH/s", 12, BLACK);
  gText(166, 96, "W", 12, BLACK);
  gText(238, 96, "ASIC", 12, BLACK);
  gText(300, 96, "BEST", 12, BLACK);
  for (int i = 0; i < NUM_MINERS; i++)
  {
    const Miner& m = data.m[i];
    int y = 112 + i * 28;
    gText(10, y, MINER_CFG[i].name, 24, BLACK);
    fmtNum(b, sizeof(b), m.ghs, 0, "");    gText(100, y, b, 24, BLACK);
    fmtNum(b, sizeof(b), m.watts, 1, "");  gText(166, y, b, 24, BLACK);
    fmtNum(b, sizeof(b), m.asic, 1, "`");  gText(238, y, b, 24, BLACK);
    // "118.14 G" -> "118.14G"
    int j = 0;
    for (int k = 0; m.best[k] && j < (int)sizeof(b) - 1; k++) if (m.best[k] != ' ') b[j++] = m.best[k];
    b[j] = 0;
    gText(300, y, b, 24, BLACK);
  }

  gHLine(8, EPD_W - 9, 200, BLACK);
  gHLine(8, EPD_W - 9, 250, BLACK);
  dottedVLine(133, 206, 292);
  dottedVLine(266, 206, 292);

  // --- Earnings (expected values) and lifetime totals ---
  fmtGrouped(b, sizeof(b), data.yrsBlock, "");     miningCell(0, 0, "Years / block", b);
  fmtGrouped(b, sizeof(b), data.satsDay, "");      miningCell(1, 0, "Sats / day", b);
  fmtUsd(b, sizeof(b), data.usdDay);               miningCell(2, 0, "USD / day", b);
  fmtSI3(b, sizeof(b), data.phTotal, 5, "H");      miningCell(0, 1, "Total hashes", b);
  miningCell(1, 1, "Best share", data.best);
  fmtNum(b, sizeof(b), data.kwhTotal, 2, " kWh");  miningCell(2, 1, "Total energy", b);
}

static void renderFrame(bool withStamp)
{
  bufClear();
  drawHeader(withStamp);
  if (!data.valid) { drawNoData(); return; }
  switch (page)
  {
    case PAGE_HOME:    renderHome();    break;
    case PAGE_WEATHER: renderWeather(); break;
    case PAGE_MINING:  renderMining();  break;
    default: break;
  }
}

// Things whose change should hit the panel right away
static void buildSigKey(char* out, size_t n)
{
  int len = snprintf(out, n, "%d|%d|%d|%d|%s|", (int)page, cursorRoom, offline,
                     data.valid, data.valid ? data.cond : statusMsg);
  for (int i = 0; i < NUM_ROOMS && len < (int)n; i++)
  {
    Room r = shownRoom(i);
    int segs = r.on ? briSegments(r.bri) : -1;
    len += snprintf(out + len, n - len, "%d%d:%s:%d|", r.valid, r.on, r.count, segs);
  }
}

// Decide whether the panel needs a refresh, and do it
static void updateDisplay()
{
  uint32_t now = millis();
  bool interactive = interactiveChange;
  bool full = forceFull;
  dirty = false;
  interactiveChange = false;
  forceFull = false;

  renderFrame(false);
  bool changed = !haveShownFrame || memcmp(Image_BW, ShownNoStamp, sizeof(Image_BW)) != 0;
  if (!changed && !full) return;

  char key[sizeof(shownSigKey)];
  buildSigKey(key, sizeof(key));
  bool significant = full || interactive || strcmp(key, shownSigKey) != 0;

  if (!significant)
  {
    if (now - lastRefreshAt < MINOR_REFRESH_MIN_MS) { dlog("Minor change, deferred (min gap)"); return; }
    if (inQuietHours()) { dlog("Minor change, deferred (quiet hours)"); return; }
  }

  memcpy(ShownNoStamp, Image_BW, sizeof(Image_BW));
  snprintf(shownSigKey, sizeof(shownSigKey), "%s", key);
  haveShownFrame = true;

  renderFrame(true);
  if (full || partialsSinceFull >= AUTO_FULL_EVERY) fullRefresh(full ? "requested" : "anti-ghost");
  else partialRefresh();

  lastRefreshAt = millis();
}

// =====================================================
// WiFi
// =====================================================
static void wifiOff()
{
  if (wifiState == WIFI_ST_OFF) return;
  WiFi.disconnect(true);
  WiFi.mode(WIFI_OFF);
  wifiState = WIFI_ST_OFF;
  dlog("WiFi off");
}

static void wifiStart()
{
  if (wifiState != WIFI_ST_OFF) return;
  WiFi.persistent(false);
  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(!USE_LIGHT_SLEEP);
  WiFi.setSleep(false);    // snappy while awake; light sleep does the saving
#if USE_STATIC_IP
  WiFi.config(IPAddress(PANEL_IP), IPAddress(PANEL_GATEWAY), IPAddress(PANEL_SUBNET), IPAddress(PANEL_DNS));
#endif
  if (haveBssid)
  {
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD, cachedChannel, cachedBssid);
    triedWithBssid = true;
  }
  else
  {
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
    triedWithBssid = false;
  }
  wifiState = WIFI_ST_CONNECTING;
  wifiStartedAt = millis();
  dlog("WiFi connecting%s", triedWithBssid ? " (cached AP)" : "");
}

static void onNetworkFailure(const char* why)
{
  dlog("Network failure: %s", why);
  failCount++;
  if (failCount >= OFFLINE_AFTER_FAILS && !offline) { offline = true; markDirty(false); }
  snprintf(statusMsg, sizeof(statusMsg), "%s", why);

  // Undo optimistic changes that never reached HA
  if (actionCount > 0)
  {
    actionCount = 0;
    for (int i = 0; i < NUM_ROOMS; i++) overrides[i].active = false;
    markDirty(true);
  }
  uint32_t now = millis();
  nextPollAt = now + POLL_INTERVAL_MS;
  fetchAt1 = fetchAt2 = 0;
  if (!data.valid) markDirty(false);   // update the status line on the boot screen
}

static void wifiService()
{
  uint32_t now = millis();
  if (wifiState == WIFI_ST_CONNECTING)
  {
    if (WiFi.status() == WL_CONNECTED)
    {
      wifiState = WIFI_ST_UP;
      memcpy(cachedBssid, WiFi.BSSID(), 6);
      cachedChannel = WiFi.channel();
      haveBssid = true;
      dlog("WiFi up in %lu ms, IP %s, ch %ld, RSSI %d", now - wifiStartedAt,
           WiFi.localIP().toString().c_str(), (long)cachedChannel, WiFi.RSSI());
    }
    else if (now - wifiStartedAt > WIFI_CONNECT_TIMEOUT_MS)
    {
      wifiOff();
      if (triedWithBssid)
      {
        // Mesh node may have changed; retry with a normal scan
        haveBssid = false;
        wifiStart();
      }
      else
      {
        wifiRetryAt = now + POLL_INTERVAL_MS;
        onNetworkFailure("WiFi connect failed");
      }
    }
  }
  else if (wifiState == WIFI_ST_UP && WiFi.status() != WL_CONNECTED)
  {
    dlog("WiFi dropped");
    wifiOff();
  }
}

// =====================================================
// Home Assistant REST
// =====================================================
static int haPost(const char* path, const String& body, String* response)
{
  HTTPClient http;
  http.setConnectTimeout(HTTP_CONNECT_TIMEOUT_MS);
  http.setTimeout(HTTP_TIMEOUT_MS);
  String url = String(HA_BASE_URL) + path;
  if (!http.begin(url)) return -1;
  http.addHeader("Authorization", "Bearer " HA_TOKEN);
  http.addHeader("Content-Type", "application/json");
  uint32_t t0 = millis();
  int code = http.POST(body);
  if (response && code == 200) *response = http.getString();
  http.end();
  dlog("POST %s -> %d (%lu ms)", path, code, millis() - t0);
  return code;
}

static float jNum(JSONVar v)
{
  return (JSONVar::typeof_(v) == "number") ? (float)(double)v : NAN;
}

static void jStr(JSONVar v, char* out, size_t n)
{
  if (JSONVar::typeof_(v) == "string") copyClean(out, n, (const char*)v);
  else snprintf(out, n, "--");
  if (!strcmp(out, "unknown") || !strcmp(out, "unavailable") || !out[0]) snprintf(out, n, "--");
}

static bool parsePayload(const String& body, HAData& d)
{
  JSONVar j = JSON.parse(body);
  if (JSONVar::typeof_(j) != "object") return false;

  float v[NUM_NUM];
  JSONVar n = j["n"];
  for (int k = 0; k < NUM_NUM; k++) v[k] = jNum(n[k]);
  d.outT = v[N_OUT_T];      d.feels = v[N_FEELS];        d.outH = v[N_OUT_H];
  d.dew = v[N_DEW];         d.rainRate = v[N_RAIN_RATE]; d.rainDay = v[N_RAIN_DAY];
  d.rainWeek = v[N_RAIN_WEEK];
  d.wind = v[N_WIND];       d.gust = v[N_GUST];          d.windDir = v[N_WIND_DIR];
  d.uv = v[N_UV];           d.press = v[N_PRESS];        d.solar = v[N_SOLAR];
  d.in1T = v[N_IN1_T];      d.in1H = v[N_IN1_H];         d.in2T = v[N_IN2_T];  d.in2H = v[N_IN2_H];
  d.th = v[N_TH];           d.watts = v[N_WATTS];        d.jth = v[N_JTH];
  d.phTotal = v[N_PH_TOTAL];
  d.btc = v[N_BTC];         d.diff = v[N_DIFF];          d.yrsBlock = v[N_YRS_BLOCK];
  d.satsDay = v[N_SATS_DAY]; d.usdDay = v[N_USD_DAY];
  d.kwhTotal = v[N_KWH_TOTAL];

  JSONVar t = j["t"];
  jStr(t[0], d.cond, sizeof(d.cond));
  jStr(t[1], d.best, sizeof(d.best));
  jStr(t[2], d.sunrise, sizeof(d.sunrise));
  jStr(t[3], d.sunset, sizeof(d.sunset));

  // Rooms: [lit, total, brightness %, [lit entity_ids]]
  JSONVar rooms = j["rooms"];
  for (int i = 0; i < NUM_ROOMS; i++)
  {
    Room& r = d.rooms[i];
    float lit = jNum(rooms[i][0]), total = jNum(rooms[i][1]);
    r.valid = !isnan(total) && total > 0;
    r.on = r.valid && !isnan(lit) && lit > 0;
    if (r.valid) snprintf(r.count, sizeof(r.count), "%d of %d on", (int)lit, (int)total);
    else snprintf(r.count, sizeof(r.count), "--");
    r.bri = jNum(rooms[i][2]);
    r.lon[0] = 0;
    JSONVar ids = rooms[i][3];
    if (JSONVar::typeof_(ids) == "array" && ids.length() > 0)
    {
      String js = JSON.stringify(ids);
      if (js.length() < sizeof(r.lon)) snprintf(r.lon, sizeof(r.lon), "%s", js.c_str());
    }
  }

  JSONVar m = j["m"];
  for (int i = 0; i < NUM_MINERS; i++)
  {
    d.m[i].ghs   = jNum(m[i][0]);
    d.m[i].watts = jNum(m[i][1]);
    d.m[i].asic  = jNum(m[i][2]);
    jStr(m[i][3], d.m[i].best, sizeof(d.m[i].best));
  }

#if SHOW_MINING
  // Totals the config left out are worked out from the miners
  float sumGhs = 0, sumW = 0;
  int haveGhs = 0, haveW = 0;
  for (int i = 0; i < NUM_MINERS; i++)
  {
    if (!isnan(d.m[i].ghs))   { sumGhs += d.m[i].ghs; haveGhs++; }
    if (!isnan(d.m[i].watts)) { sumW += d.m[i].watts; haveW++; }
  }
  if (isnan(d.th) && haveGhs)    d.th = sumGhs / 1000.0f;
  if (isnan(d.watts) && haveW)   d.watts = sumW;
  if (isnan(d.jth) && !isnan(d.th) && !isnan(d.watts) && d.th > 0) d.jth = d.watts / d.th;
#endif

  jStr(j["ts"], d.ts, sizeof(d.ts));
  float hr = jNum(j["hr"]);
  d.hour = isnan(hr) ? -1 : (int)hr;
  d.valid = true;
  return true;
}

static void doFetch()
{
  uint32_t now = millis();
  if (fetchAt1 && timeReached(now, fetchAt1)) fetchAt1 = 0;
  if (fetchAt2 && timeReached(now, fetchAt2)) fetchAt2 = 0;
  nextPollAt = now + POLL_INTERVAL_MS;

  JSONVar req;
  req["template"] = haTemplate.c_str();
  String body = JSON.stringify(req);
  String resp;
  int code = haPost("/api/template", body, &resp);

  if (code != 200)
  {
    char why[64];
    if (code == 401) snprintf(why, sizeof(why), "HA 401: check HA_TOKEN");
    else if (code < 0) snprintf(why, sizeof(why), "HA unreachable (%d)", code);
    else snprintf(why, sizeof(why), "HA error %d", code);
    onNetworkFailure(why);
    return;
  }

  static HAData d;          // static: ~2.5 KB, keep it off the loop stack
  d = data;
  if (!parsePayload(resp, d))
  {
    dlog("Bad payload: %.120s", resp.c_str());
    onNetworkFailure("HA payload not JSON");
    return;
  }
  data = d;
  failCount = 0;
  if (offline) offline = false;
  snprintf(statusMsg, sizeof(statusMsg), "OK");

  // Drop optimistic overrides once HA agrees, or when they expire
  now = millis();
  for (int i = 0; i < NUM_ROOMS; i++)
  {
    Override& o = overrides[i];
    if (!o.active) continue;
    const Room& f = data.rooms[i];
    bool briAgrees = !o.hasBri || !o.on || isnan(f.bri) || fabsf(f.bri - o.bri) <= 2 * BRI_TOL;
    if ((f.valid && f.on == o.on && briAgrees) || timeReached(now, o.expiresAt)) o.active = false;
  }

  char lights[NUM_ROOMS + 1];
  for (int i = 0; i < NUM_ROOMS; i++) lights[i] = data.rooms[i].on ? '1' : '0';
  lights[NUM_ROOMS] = 0;
  dlog("Data: out %.1f, cond %s, lights %s, %.2f TH/s, ts %s",
       data.outT, data.cond, lights, data.th, data.ts);
  markDirty(false);
}

// =====================================================
// Light actions (optimistic)
// =====================================================
static void enqueueAction(const char* domain, const char* service, const String& body)
{
  if (actionCount >= ACTION_QUEUE_LEN) { dlog("Action queue full, dropping"); return; }
  if (body.length() >= sizeof(actionQueue[0].body)) { dlog("Action body too long, dropping"); return; }
  Action& a = actionQueue[actionCount++];
  snprintf(a.path, sizeof(a.path), "/api/services/%s/%s", domain, service);
  snprintf(a.body, sizeof(a.body), "%s", body.c_str());
}

// light.<service> for a tile: its area, or every light for an "All" tile
static void enqueueRoomLights(const char* service, int i)
{
  JSONVar req;
  if (isAllRoom(i)) req["entity_id"] = "all";
  else req["area_id"] = ROOMS[i].area;
  enqueueAction("light", service, JSON.stringify(req));
}

static void setOverride(int i, bool on)
{
  Override& o = overrides[i];
  Room cur = shownRoom(i);
  int a, b;
  o.active = true;
  o.on = on;
  o.hasBri = false;
  o.expiresAt = millis() + 30000;   // shortened once the command is sent
  if (!isAllRoom(i) && cur.valid && cur.on == on)
  {
    snprintf(o.count, sizeof(o.count), "%s", cur.count);   // state unchanged: keep "2 of 4"
  }
  else if (isAllRoom(i))
  {
    // Sum the (possibly overridden) rooms
    int sa = 0, sb = 0;
    bool ok = false;
    for (int k = 0; k < NUM_ROOMS; k++)
    {
      if (isAllRoom(k)) continue;
      Room r = shownRoom(k);
      if (parseCount(r.count, &a, &b)) { sa += a; sb += b; ok = true; }
    }
    if (ok) snprintf(o.count, sizeof(o.count), "%d of %d on", sa, sb);
    else    snprintf(o.count, sizeof(o.count), "%s", on ? "ON" : "off");
  }
  else if (parseCount(data.rooms[i].count, &a, &b))
  {
    snprintf(o.count, sizeof(o.count), "%d of %d on", on ? b : 0, b);
  }
  else
  {
    snprintf(o.count, sizeof(o.count), "%s", on ? "ON" : "off");
  }
}

// After a room changes, "All" tiles follow: on if any room is on
static void syncAllTiles()
{
  bool any = false;
  for (int k = 0; k < NUM_ROOMS; k++)
    if (!isAllRoom(k)) { Room rk = shownRoom(k); any |= (rk.valid && rk.on); }
  for (int k = 0; k < NUM_ROOMS; k++)
  {
    if (!isAllRoom(k)) continue;
    Room before = shownRoom(k);
    setOverride(k, any);
    if (any && !isnan(before.bri)) { overrides[k].hasBri = true; overrides[k].bri = before.bri; }
  }
}

static void toggleRoom(int i)
{
  Room r = shownRoom(i);
  bool newOn = !(r.valid && r.on);
  const char* svc = newOn ? "turn_on" : "turn_off";

  if (isAllRoom(i))
  {
    for (int k = 0; k < NUM_ROOMS; k++) if (!isAllRoom(k)) setOverride(k, newOn);
    for (int k = 0; k < NUM_ROOMS; k++) if (isAllRoom(k)) setOverride(k, newOn);
  }
  else
  {
    setOverride(i, newOn);
    syncAllTiles();
  }
  enqueueRoomLights(svc, i);
  dlog("Toggle %s -> %s", ROOMS[i].name, newOn ? "ON" : "off");
}

// Optimistic brightness for one room; turns it off at 0
static void setBriOverride(int i, float pct)
{
  setOverride(i, pct > 0);
  overrides[i].hasBri = pct > 0;
  overrides[i].bri = pct;
}

// Next level up or down from a reading. 0 = off (stepped below the lowest).
static int nextBriLevel(float cur, int dir)
{
  if (dir > 0)
  {
    for (int k = 0; k < NUM_BRI_LEVELS; k++) if (BRI_LEVELS[k] > cur + BRI_TOL) return BRI_LEVELS[k];
    return BRI_LEVELS[NUM_BRI_LEVELS - 1];
  }
  for (int k = NUM_BRI_LEVELS - 1; k >= 0; k--) if (BRI_LEVELS[k] < cur - BRI_TOL) return BRI_LEVELS[k];
  return 0;
}

// dir = +1 brighter, -1 dimmer, moving through BRIGHTNESS_LEVELS. Lights are
// set to an absolute level (not a relative step), so on an "All" tile every
// lit light lands on the same level: All is the master. Only lights that are
// on are touched; a dark tile stepped up turns on at the lowest level.
static void stepBrightness(int i, int dir)
{
  Room r = shownRoom(i);
  bool wasOn = r.valid && r.on;
  if (!wasOn && dir < 0) return;

  float cur = wasOn ? (isnan(r.bri) ? 100 : r.bri) : 0;
  int lvl = wasOn ? nextBriLevel(cur, dir) : BRI_LEVELS[0];

  JSONVar req;
  JSONVar ids = JSON.parse(r.lon);
  if (wasOn && r.lon[0]) req["entity_id"] = ids;
  else if (!isAllRoom(i)) req["area_id"] = ROOMS[i].area;
  else req["entity_id"] = "all";
  if (lvl > 0) req["brightness_pct"] = lvl;

  if (isAllRoom(i))
  {
    for (int k = 0; k < NUM_ROOMS; k++)
    {
      if (isAllRoom(k)) continue;
      Room rk = shownRoom(k);
      if (!wasOn || (rk.valid && rk.on)) setBriOverride(k, lvl);
    }
    for (int k = 0; k < NUM_ROOMS; k++) if (isAllRoom(k)) setBriOverride(k, lvl);
  }
  else
  {
    setBriOverride(i, lvl);
    syncAllTiles();
  }
  enqueueAction("light", lvl > 0 ? "turn_on" : "turn_off", JSON.stringify(req));
  dlog("Brightness %s %s: %.0f%% -> %d%%", ROOMS[i].name, dir > 0 ? "up" : "down", cur, lvl);
}

// Hold EXIT: all lights off, or all back on (at their last brightness) when
// every tile is known to be off. With no data yet it always turns them off.
static void allLightsOffOrOn()
{
  bool anyOn = false, anyKnown = false;
  for (int k = 0; k < NUM_ROOMS; k++)
  {
    Room r = shownRoom(k);
    if (r.valid) { anyKnown = true; anyOn |= r.on; }
  }
  bool on = anyKnown && !anyOn;
  for (int k = 0; k < NUM_ROOMS; k++) setOverride(k, on);
  JSONVar req;
  req["entity_id"] = "all";
  enqueueAction("light", on ? "turn_on" : "turn_off", JSON.stringify(req));
  dlog("All lights %s", on ? "on" : "off");
}

// Sends one queued action. Returns true if one was sent.
static bool processOneAction()
{
  if (actionCount == 0) return false;
  Action a = actionQueue[0];
  for (int i = 1; i < actionCount; i++) actionQueue[i - 1] = actionQueue[i];
  actionCount--;

  int code = haPost(a.path, String(a.body), nullptr);

  uint32_t now = millis();
  if (code == 200)
  {
    for (int i = 0; i < NUM_ROOMS; i++)
      if (overrides[i].active) overrides[i].expiresAt = now + OVERRIDE_HOLD_MS;
    fetchAt1 = now + REFETCH_1_MS;
    fetchAt2 = now + REFETCH_2_MS;
  }
  else
  {
    // Revert to what HA last reported and re-check now
    for (int i = 0; i < NUM_ROOMS; i++) overrides[i].active = false;
    actionCount = 0;
    fetchAt1 = now;
    snprintf(statusMsg, sizeof(statusMsg), "Command failed (%d)", code);
    markDirty(true);
  }
  return true;
}

static void expireOverrides()
{
  if (actionCount > 0) return;
  uint32_t now = millis();
  for (int i = 0; i < NUM_ROOMS; i++)
  {
    if (overrides[i].active && timeReached(now, overrides[i].expiresAt))
    {
      overrides[i].active = false;
      markDirty(false);
    }
  }
}

// =====================================================
// Easter egg
// =====================================================
#if HAVE_EGGS
// Copy one egg into the frame buffer. The egg format and the panel buffer
// share layout (row-major, MSB = leftmost pixel) but have opposite polarity:
// egg 1 = black, panel 1 = white. A 400 x 300 egg is a straight inverted
// copy; any other size is drawn centred, clipped to the panel.
static void drawEgg(int idx)
{
  const uint8_t* bmp = EGGS[idx];
  const int rowBytes = (EGG_WIDTH + 7) / 8;
  if (EGG_WIDTH == EPD_W && EGG_HEIGHT == EPD_H)
  {
    for (int i = 0; i < rowBytes * EGG_HEIGHT; i++) Image_BW[i] = (uint8_t)~pgm_read_byte(bmp + i);
    return;
  }
  bufClear();
  const int ox = (EPD_W - EGG_WIDTH) / 2, oy = (EPD_H - EGG_HEIGHT) / 2;
  for (int y = 0; y < EGG_HEIGHT; y++)
    for (int x = 0; x < EGG_WIDTH; x++)
      if (pgm_read_byte(bmp + y * rowBytes + (x >> 3)) & (0x80 >> (x & 7))) gPx(ox + x, oy + y, BLACK);
}
#endif

static void showRandomEgg()
{
#if HAVE_EGGS
  if (EGG_COUNT == 0) return;
  // Random, but never the same photo twice in a row
  int idx;
  if (EGG_COUNT == 1 || lastEgg < 0) idx = esp_random() % EGG_COUNT;
  else
  {
    idx = esp_random() % (EGG_COUNT - 1);
    if (idx >= lastEgg) idx++;
  }
  lastEgg = idx;
  dlog("Easter egg %d/%d: %s", idx + 1, (int)EGG_COUNT, EGG_NAMES[idx]);

  drawEgg(idx);
  fullRefresh("easter egg");   // full refresh: dithered photos ghost badly with partials
  eggActive = true;
  eggUntil = millis() + EGG_SHOW_MS;
  haveShownFrame = false;      // the panel no longer shows the dashboard
  lastRefreshAt = millis();
  lastInputAt = millis();
#else
  dlog("Easter egg: no easter_eggs.h or easter_eggs_example.h in the sketch folder");
#endif
}

static void exitEgg()
{
  if (!eggActive) return;
  dlog("Easter egg: back to the dashboard");
  eggActive = false;
  forceFull = true;            // clean slate after the photo
  markDirty(true);
}

// =====================================================
// Buttons
// =====================================================
static void noteInput()
{
  lastInputAt = millis();
  markDirty(true);
  // Someone is at the panel: bring WiFi up now so a light command a moment
  // later doesn't wait for the reconnect
  if (wifiState == WIFI_ST_OFF) wifiStart();
}

// While a photo is up, any single button just returns to the dashboard
static bool eggSwallowsButton()
{
  if (!eggActive) return false;
  exitEgg();
  lastInputAt = millis();
  return true;
}

static void onShort(int b)
{
  dlog("BUTTON: %s", BTN_NAMES[b]);
  if (eggSwallowsButton()) return;
  switch (b)
  {
    case B_MENU:
      page = (Page)((page + 1) % NUM_PAGES);
      break;

    case B_OK:
      if (lightsFocused()) toggleRoom(cursorRoom);
      break;

    case B_UP:
    case B_DOWN:
    {
      if (!lightsFocused()) break;
      int d = (b == B_DOWN) ? 1 : -1;
      if (btnHeld[B_MENU])
      {
        // MENU held: brightness instead of moving the box
        btnUsedAsMod[B_MENU] = true;
        stepBrightness(cursorRoom, b == B_UP ? 1 : -1);
        break;
      }
      cursorRoom = (cursorRoom + d + NUM_ROOMS) % NUM_ROOMS;
      break;
    }

    case B_EXIT:
      page = PAGE_HOME;
      break;
  }
  noteInput();
}

static void onLong(int b)
{
  dlog("BUTTON: %s (long)", BTN_NAMES[b]);
  if (eggSwallowsButton()) return;
  if (b == B_OK)
  {
    forceFull = true;
    nextPollAt = millis();      // grab fresh data too
  }
  else if (b == B_EXIT)
  {
    page = PAGE_HOME;
    allLightsOffOrOn();
  }
  // B_MENU: nothing. Holding it 1 s just cancels the page change.
  noteInput();
}

// One debounced edge from the button task, in the order it happened
static void processButtonEvent(const BtnEvent& e)
{
  const int i = e.btn;
  if (e.down)
  {
    btnHeld[i] = true;
    if (BTN_ON_RELEASE[i]) { btnLongFired[i] = false; btnUsedAsMod[i] = false; btnDownAt[i] = e.t; }
    else onShort(i);

    // MENU + EXIT held together for LONG_PRESS_MS = Easter egg (or the next
    // photo while one is up); handleButtons() times it. Both act on release,
    // so neither has fired anything yet, and neither will now.
    if (btnHeld[B_MENU] && btnHeld[B_EXIT] && !comboFired)
    {
      comboFired = true;
      comboStartAt = e.t;
      btnLongFired[B_MENU] = btnLongFired[B_EXIT] = true;   // no short/long on release
    }
    return;
  }

  if (!btnHeld[i]) return;
  btnHeld[i] = false;
  if (BTN_ON_RELEASE[i] && !btnLongFired[i] && !btnUsedAsMod[i])
  {
    // Use the event's own timestamps, so a press that ended while the loop
    // was busy is still judged short or long correctly
    if (BTN_HAS_LONG[i] && e.t - btnDownAt[i] >= LONG_PRESS_MS) { btnLongFired[i] = true; onLong(i); }
    else onShort(i);
  }
  if (!btnHeld[B_MENU] && !btnHeld[B_EXIT]) comboFired = comboShown = false;
}

static void handleButtons()
{
  BtnEvent e;
  while (xQueueReceive(btnQueue, &e, 0) == pdTRUE) processButtonEvent(e);

  // Long presses fire while still held
  uint32_t now = millis();
  if (comboFired && !comboShown && btnHeld[B_MENU] && btnHeld[B_EXIT] && now - comboStartAt >= LONG_PRESS_MS)
  {
    comboShown = true;
    dlog("BUTTON: MENU + EXIT (held)");
    showRandomEgg();
  }
  for (int i = 0; i < NUM_BTNS; i++)
  {
    if (BTN_HAS_LONG[i] && btnHeld[i] && !btnLongFired[i] && !btnUsedAsMod[i] && now - btnDownAt[i] >= LONG_PRESS_MS)
    {
      btnLongFired[i] = true;
      onLong(i);
    }
  }
}

static bool anyButtonDown()
{
  if (btnQueue && uxQueueMessagesWaiting(btnQueue) > 0) return true;
  for (int i = 0; i < NUM_BTNS; i++) if (btnHeld[i] || btnRawDown[i]) return true;
  return false;
}

// =====================================================
// Light sleep
// =====================================================
static void lightSleepFor(uint32_t ms)
{
  wifiOff();
  dlog("Sleep %lu ms", ms);
  Serial.flush();

  for (int i = 0; i < NUM_BTNS; i++) gpio_wakeup_enable((gpio_num_t)BTN_PINS[i], GPIO_INTR_LOW_LEVEL);
  esp_sleep_enable_gpio_wakeup();
  esp_sleep_enable_timer_wakeup((uint64_t)ms * 1000ULL);
  for (int p : EPD_OUT_PINS) gpio_hold_en((gpio_num_t)p);

  esp_light_sleep_start();

  for (int p : EPD_OUT_PINS) gpio_hold_dis((gpio_num_t)p);
  for (int i = 0; i < NUM_BTNS; i++) gpio_wakeup_disable((gpio_num_t)BTN_PINS[i]);
  esp_sleep_disable_wakeup_source(ESP_SLEEP_WAKEUP_ALL);

  esp_sleep_wakeup_cause_t cause = esp_sleep_get_wakeup_cause();
  dlog("Wake: %s", cause == ESP_SLEEP_WAKEUP_GPIO ? "button" : (cause == ESP_SLEEP_WAKEUP_TIMER ? "timer" : "other"));
}

static bool fetchDue(uint32_t now)
{
  return timeReached(now, nextPollAt) ||
         (fetchAt1 && timeReached(now, fetchAt1)) ||
         (fetchAt2 && timeReached(now, fetchAt2));
}

static void maybeSleep()
{
  if (!USE_LIGHT_SLEEP) return;
  uint32_t now = millis();
  if ((dirty && !eggActive) || actionCount > 0 || fetchAt1 || fetchAt2) return;
  if (wifiState == WIFI_ST_CONNECTING) return;
  if (now - lastInputAt < AWAKE_AFTER_INPUT_MS) return;
  if (anyButtonDown()) return;
  if (fetchDue(now)) return;

  uint32_t wakeAt = nextPollAt;
  if (eggActive && (int32_t)(eggUntil - wakeAt) < 0) wakeAt = eggUntil;
  int32_t ms = (int32_t)(wakeAt - now);
  if (ms < 100) return;
  lightSleepFor((uint32_t)ms);
}

// =====================================================
// setup / loop
// =====================================================
void setup()
{
  Serial.setTxBufferSize(2048);   // log lines go to a buffer instead of blocking the loop
  Serial.begin(115200);
  delay(300);
  Serial.println();
  Serial.println("=== Crow's Nest ===");

  pinMode(PIN_EPD_PWR, OUTPUT); digitalWrite(PIN_EPD_PWR, HIGH);
  pinMode(PIN_PWR_LED, OUTPUT); updatePowerLed(false, false);
  for (int i = 0; i < NUM_BTNS; i++)
  {
    pinMode(BTN_PINS[i], INPUT_PULLUP);
    btnHeld[i] = btnLongFired[i] = btnUsedAsMod[i] = false;
  }
  btnQueue = xQueueCreate(32, sizeof(BtnEvent));
  xTaskCreatePinnedToCore(buttonTask, "buttons", 2048, nullptr, 3, nullptr, 0);

  memset(&data, 0, sizeof(data));
  data.valid = false;
  data.hour = -1;
  memset(overrides, 0, sizeof(overrides));

  EPD_GPIOInit();

  // Lifetime refresh counters
  // (the Arduino core has already initialised NVS; a missing key leaves 0)
  if (nvs_open("panel", NVS_READWRITE, &statsNvs) == ESP_OK)
  {
    nvs_get_u32(statsNvs, "full", &lifetimeFull);
    nvs_get_u32(statsNvs, "partial", &lifetimePartial);
  }
  else
  {
    statsNvs = 0;
    dlog("NVS unavailable: lifetime refresh counts will not be saved");
  }
  logRefreshCounts();

  // Build the HA template from config.h and print it, so it can be pasted
  // into Home Assistant > Developer Tools > Template to check every value
  buildTemplate();
  Serial.println("----- HA template (paste into Developer Tools > Template) -----");
  Serial.println(haTemplate);
  Serial.println("---------------------------------------------------------------");

  if (strstr(HA_TOKEN, "paste-") == HA_TOKEN)
    snprintf(statusMsg, sizeof(statusMsg), "Set HA_TOKEN in secrets.h");
  else
    snprintf(statusMsg, sizeof(statusMsg), "Connecting to WiFi");

  forceFull = true;
  updateDisplay();          // boot screen, full refresh + prime

  nextPollAt = millis();    // fetch immediately
  lastInputAt = millis();   // stay awake through the first fetch
}

void loop()
{
  handleButtons();
  wifiService();
  expireOverrides();

  uint32_t now = millis();

  // A button command skips the WiFi back-off; polls respect it
  bool needNet = actionCount > 0 || fetchDue(now) || !USE_LIGHT_SLEEP;
  if (needNet && wifiState == WIFI_ST_OFF && (actionCount > 0 || timeReached(now, wifiRetryAt))) wifiStart();

  if (wifiState == WIFI_ST_UP)
  {
    // Commands first so lights respond before the screen catches up
    if (!processOneAction() && fetchDue(millis())) doFetch();
  }
  else if (fetchDue(now) && !timeReached(now, wifiRetryAt))
  {
    // WiFi is backing off: push the poll to the retry time
    nextPollAt = wifiRetryAt;
  }

  if (eggActive)
  {
    // Data keeps updating underneath; the dashboard redraws when the egg ends
    if (timeReached(millis(), eggUntil)) exitEgg();
  }
  else if (dirty && millis() - lastInputAt >= COALESCE_MS)
  {
    updateDisplay();
  }

  maybeSleep();
  delay(5);
}
